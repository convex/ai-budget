{
  "name": "@convex-dev/ai-budget",
  "description": "Metered, budget-governed AI spend for Convex — the AI Gateway or any provider (fal, Replicate, image/audio gen, a raw fetch) via ai.meter: cost & usage tracking, per-user/per-action/global spend/token/rate limits, request logging, re-run, and an Agent-component adapter.",
  "repository": "github:get-convex/ai-budget",
  "homepage": "https://github.com/get-convex/ai-budget#readme",
  "bugs": {
    "email": "support@convex.dev",
    "url": "https://github.com/get-convex/ai-budget/issues"
  },
  "version": "1.1.2",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "convex",
    "convex-component",
    "ai-gateway",
    "llm",
    "usage",
    "cost",
    "budget",
    "rate-limit"
  ],
  "scripts": {
    "dev": "convex dev --start 'npm run dev:build'",
    "dev:frontend": "cd example && vite --clearScreen false",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.ts' -i '**/*.test.ts' -c 'npm run build:codegen' --initial",
    "predev": "convex init && npm run build:codegen",
    "build": "tsc --project ./tsconfig.build.json",
    "build:codegen": "convex codegen --component-dir ./src/component && npm run build",
    "build:clean": "rm -rf dist *.tsbuildinfo && npm run build:codegen",
    "typecheck": "tsc --noEmit --project ./tsconfig.build.json && tsc --noEmit -p example && tsc --noEmit -p example/convex",
    "test": "vitest run --typecheck",
    "lint": "eslint .",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "preversion": "npm ci && npm run build:clean && npm run test && npm run lint && npm run typecheck",
    "alpha": "npm version prerelease --preid alpha && npm publish --tag alpha && git push --follow-tags",
    "release": "npm version patch && npm publish && git push --follow-tags",
    "version": "(npm whoami || npm login) && vim -c 'normal o' -c 'normal o## '$npm_package_version CHANGELOG.md && prettier -w CHANGELOG.md && git add CHANGELOG.md"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "default": "./dist/eslint/index.js"
    }
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js",
  "dependencies": {
    "@convex-dev/rate-limiter": "^0.4.1",
    "@convex-dev/sharded-counter": "^0.2.2",
    "convex-helpers": "^0.1.127"
  },
  "peerDependencies": {
    "@convex-dev/ai-sdk-provider": ">=0.2.1",
    "ai": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "convex": "^1.46.0",
    "eslint": ">=8.57.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@convex-dev/agent": "0.7.6",
    "@convex-dev/ai-sdk-provider": "^0.2.1",
    "@convex-dev/eslint-plugin": "5.0.0",
    "@convex-dev/rate-limiter": "0.4.1",
    "@convex-dev/sharded-counter": "0.2.2",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ai": "^7.0.108",
    "chokidar-cli": "3.0.0",
    "convex": "1.46.0",
    "convex-test": "https://pkg.pr.new/convex-test@163",
    "eslint": "10.12.0",
    "globals": "^17.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.0",
    "vitest": "4.1.11"
  }
}
